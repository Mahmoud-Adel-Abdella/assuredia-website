{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd artifacts/api-server && pnpm build"
  },
  "deploy": {
    "startCommand": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "healthcheckPath": "/api/health"
  }
}